# Validated experimental operating point on Apple MPS for generic RRF retrieval.
# Source in the shell which starts the API. Set your own catalog and OpenViking scope separately.
export EVIDENCE_RAG_DEFAULT_PROFILE=general
export EVIDENCE_RAG_RERANKER=bge
export EVIDENCE_RAG_RERANK_DEVICE=mps
export EVIDENCE_RAG_RERANK_DTYPE=float16
export EVIDENCE_RAG_GENERAL_RERANK_TOP_N=24
export EVIDENCE_RAG_RERANK_WINDOW_CHECK=auto
export EVIDENCE_RAG_RERANK_LONG_INPUT=split
export EVIDENCE_RAG_RERANK_BATCH_SIZE=4
